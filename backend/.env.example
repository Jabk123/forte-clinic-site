# ============================================================
# DATABASE CONNECTION STRING — PUT IT HERE (server-side only)
# ============================================================
# Never commit the real .env file. Copy this to .env and fill in.

# Microsoft SQL Server example (Azure SQL or on-prem):
DB_CONNECTION_STRING="Server=YOUR_SERVER.database.windows.net;Database=ForteCommunityClinicDB;User Id=YOUR_USER;Password=YOUR_PASSWORD;Encrypt=true;TrustServerCertificate=false;"

# Local SQL Server with Windows Authentication (development):
# DB_CONNECTION_STRING="Server=localhost;Database=ForteCommunityClinicDB;Trusted_Connection=True;TrustServerCertificate=true;"

# Local SQL Server with SQL Auth:
# DB_CONNECTION_STRING="Server=localhost;Database=ForteCommunityClinicDB;User Id=sa;Password=YourStrongPassword;Encrypt=true;TrustServerCertificate=true;"

PORT=3000
JWT_SECRET=change-me-to-a-long-random-string
CORS_ORIGIN=http://localhost:5500,https://YOUR_USERNAME.github.io

# Password reset email (Gmail SMTP). Enable 2-Step Verification and create an app password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
PUBLIC_APP_URL=http://127.0.0.1:5500
